meta {
  name: Upload Data
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/upload_data
  body: json
  auth: inherit
}

body:json {
  {
    "group_id": "{{group_id}}",
    "timestamp": "{{timestamp}}",
    "data": {
      "day_in_study": 1,
      "week_in_study": {{week_in_study}},
      "slot": "am",
      "aya_diary_mood": 4,
      "aya_diary_physical": 4,
      "aya_app_engagement": 2,
      "aya_app_burden": 0.0,
      "aya_missing_rate_7d": 0.0,
      "previous_med_adherence": 1,
      "prompted_by_message": false,
      "aya_messages_delivered_week": 0,
      "cp_diary_mood": 4,
      "cp_app_engagement": 2,
      "cp_app_burden": 0.0,
      "cp_missing_rate_7d": 0.0,
      "daily_diary_completed": true,
      "cp_prompted_by_message": false,
      "cp_messages_delivered_week": 0,
      "relationship_quality_aya": 4,
      "relationship_quality_cp": 4,
      "current_game_on": "miss",
      "prior_game_action": "miss",
      "aya_diary_summary": 0.5,
      "cp_diary_summary": 0.5,
      "weekly_survey_completed": true,
      "weekly_relationship_score": 1.0
    }
  }
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 10000
}
