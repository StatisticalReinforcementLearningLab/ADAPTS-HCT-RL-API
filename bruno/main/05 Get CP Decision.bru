meta {
  name: Get CP Decision
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/action
  body: json
  auth: inherit
}

body:json {
  {
    "decision_type": "cp_message",
    "group_id": "{{group_id}}",
    "decision_idx": 1,
    "timestamp": "{{timestamp}}"
  }
}

assert {
  res.status: eq 201
}
