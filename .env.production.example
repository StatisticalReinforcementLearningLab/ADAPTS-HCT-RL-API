# Generate with: openssl rand -hex 32
# Use only URL-safe characters because this value is interpolated into the DB URI.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# The API binds only to the VM loopback interface by default. Set this to the
# VM's private VPC address only when a host server on the same VPC must call it.
ADAPTS_BIND_ADDRESS=127.0.0.1
ADAPTS_PORT=8000

MONITOR_STUDY_TZ=America/Detroit
MONITOR_RUN_EVERY_SECONDS=300
